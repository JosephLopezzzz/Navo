      "css": ".ds-stop-row{display:flex;align-items:center;gap:12px;min-height:42px;padding:0 8px;border-bottom:1px solid #D9E0DC;color:#17211F;font:400 15px system-ui,sans-serif}.ds-stop-number{width:28px;color:#53615E;font:700 12px system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-stop-name{flex:1}.ds-stop-state{color:#246DD0;font:700 10px system-ui,sans-serif;letter-spacing:.5px}"
    }
