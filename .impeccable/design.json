  "narrative": {
    "northStar": "Deep Current, Quiet Route Plate",
    "overview": "Navo carries a permanent navy, sapphire, and aqua identity across themes. The default Arctic Pearl interface is bright and quiet; Obsidian is a manually selected night palette. The Navo gradient is reserved for the mark, splash branding, active trip progress, and a few important branded highlights. Most surfaces stay solid, while the connected route line, manual progress, and source-quality seal keep the trip legible without implying an ETA or live service data. The selected appearance is applied to native controls and system alerts in this app.",
    "keyCharacteristics": [
      "Deep Current brand colors remain recognizable in either theme.",
      "Arctic Pearl is the default; Obsidian is an optional saved preference.",
      "Solid mobile surfaces make the route, destination, and reliability state easy to scan."
    ],
    "rules": [
      {
        "name": "The Gradient Reserve Rule",
        "body": "Use the exact Navo gradient for the mark, splash brand, active route progress, and rare important highlights. Keep ordinary controls and surfaces solid.",
        "section": "colors"
      },
      {
        "name": "The Signal First Rule",
        "body": "Put the destination, next stop, and trip action ahead of source and reliability detail. Keep reliability visible without giving it headline weight.",
        "section": "typography"
      },
      {
        "name": "The Flat Plate Rule",
        "body": "Separate route information with space, tone, and hairline dividers instead of floating-card shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do default to Arctic Pearl and let riders choose Obsidian in Settings.",
      "Do keep Brand Midnight as the app and launcher backplate in every theme.",
      "Do use gradient only for the mark, splash brand, active progress, and important highlights.",
      "Do keep manual progress and route-data quality visible."
    ],
    "donts": [
      "Do not use Brand Aqua for small text on light surfaces.",
      "Do not show unverified station coordinates as operational route data.",
      "Do not imply an ETA, live service feed, guaranteed alert delivery, or alarm-clock override.",
      "Do not add map decoration until route coordinates have been checked."
    ]
  }
}
