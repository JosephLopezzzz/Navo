    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single main action on a screen.",
      "html": "<button class=\"ds-button-primary\">Start destination alarm</button>",
      "css": ".ds-button-primary{background:#246DD0;color:#FFFFFF;border:0;border-radius:14px;min-height:54px;padding:0 24px;font:700 16px system-ui,sans-serif;transition:opacity .15s ease}.ds-button-primary:hover{opacity:.9}.ds-button-primary:focus-visible{outline:3px solid #087D73;outline-offset:3px}.ds-button-primary:active{opacity:.78}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A reversible alternative action.",
      "html": "<button class=\"ds-button-secondary\">End trip</button>",
      "css": ".ds-button-secondary{background:transparent;color:#17211F;border:1px solid #D9E0DC;border-radius:14px;min-height:50px;padding:0 24px;font:700 16px system-ui,sans-serif;transition:opacity .15s ease}.ds-button-secondary:hover{background:#F0F2EF}.ds-button-secondary:focus-visible{outline:3px solid #246DD0;outline-offset:3px}.ds-button-secondary:active{opacity:.72}"
    },
    {
      "name": "Bus Route Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "A native-style route name field with a quiet underline.",
      "html": "<label class=\"ds-field-label\" for=\"route-name\">Route name</label><input id=\"route-name\" class=\"ds-route-field\" value=\"EDSA Carousel\" />",
      "css": ".ds-field-label{display:block;color:#53615E;font:700 11px system-ui,sans-serif;letter-spacing:.7px;text-transform:uppercase}.ds-route-field{box-sizing:border-box;width:100%;min-height:48px;padding:0 2px;color:#17211F;background:transparent;border:0;border-bottom:1px solid #D9E0DC;border-radius:0;font:400 16px system-ui,sans-serif}.ds-route-field:focus-visible{outline:2px solid #246DD0;outline-offset:2px}"
    },
    {
      "name": "Data Seal",
      "kind": "chip",
      "refersTo": "data-seal",
      "description": "Compact source or reliability status.",
      "html": "<span class=\"ds-data-seal\"><span class=\"ds-seal-dot\"></span>Station order only</span>",
      "css": ".ds-data-seal{display:inline-flex;align-items:center;gap:7px;min-height:28px;padding:0 9px;color:#53615E;background:#F0F2EF;border:1px solid #53615E;border-radius:7px;font:700 11px system-ui,sans-serif;letter-spacing:.45px;text-transform:uppercase}.ds-seal-dot{width:6px;height:6px;flex:0 0 6px;background:#53615E;border-radius:50%}"
    },
    {
      "name": "Route Progress",
      "kind": "custom",
      "refersTo": "route-line",
      "description": "One connected route with a distinct passed, next, and destination state.",
      "html": "<div class=\"ds-route-progress\"><span class=\"ds-stop ds-passed\">1</span><span class=\"ds-route-segment\"></span><span class=\"ds-stop ds-next\">2</span><span class=\"ds-route-segment\"></span><span class=\"ds-stop ds-destination\">3</span></div>",
      "css": ".ds-route-progress{display:flex;align-items:center;width:100%;min-height:24px}.ds-stop{display:grid;place-items:center;width:22px;height:22px;border:2px solid #71807D;border-radius:50%;font:700 10px system-ui,sans-serif}.ds-passed,.ds-next{color:#FFFFFF;background:#246DD0;border-color:#246DD0}.ds-destination{color:#17211F;background:#FFFFFF;border-color:#246DD0}.ds-route-segment{height:2px;flex:1;background:#D9E0DC}.ds-passed+.ds-route-segment{background:#246DD0}"
    },
    {
      "name": "Numbered Stop Row",
      "kind": "custom",
      "refersTo": "route-line",
